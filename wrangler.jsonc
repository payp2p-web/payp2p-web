{
  "name": "payp2p-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "payp2p-db",
      "database_id": "PASTE_YOUR_DATABASE_ID_HERE"
    }
  ]
}
